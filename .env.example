AGENTMAIL_API_KEY=
EXA_API_KEY=
KERNEL_API_KEY=
KERNEL_PROJECT_ID=
DATABASE_URL=
AI_GATEWAY_API_KEY=

# AgentMail webhook signing secret (starts with whsec_). From the AgentMail console, webhook settings.
AGENTMAIL_WEBHOOK_SECRET=

# Optional. Name of the Kernel browser profile that holds the logged-in accounts (loaded read-only).
KERNEL_PROFILE=
# Optional. Shared secret for the dev-only approval endpoints in scripts/run-agent.ts. Endpoints are disabled when unset.
DEV_APPROVAL_TOKEN=
