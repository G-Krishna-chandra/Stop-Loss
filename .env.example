# Copy to .env.local and fill in. Never commit real values.

# Neon: pooled connection string for the app; the direct one (optional) for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AgentMail: the StopLoss address. The webhook secret (whsec_...) comes from the webhook you register.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Optional: the inbox username to request (otherwise AgentMail picks one).
STOPLOSS_INBOX_USERNAME=

# Exa: trial terms research.
EXA_API_KEY=

# Kernel: live browsers for cancels and sign-ups.
KERNEL_API_KEY=
KERNEL_PROJECT_ID=

# Neon AI Gateway: models for email extraction and the browser agent (Neon console → branch → AI Gateway).
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
AGENT_MODEL=claude-sonnet-5
EXTRACT_MODEL=claude-haiku-4-5

# Vercel Cron calls /api/cron/stops with this bearer token.
CRON_SECRET=

# How many hours before renewal StopLoss asks you.
STOP_LEAD_HOURS=24
# Name the agent uses when it signs up for a trial.
STOPLOSS_FULL_NAME=

# Local development only: lets `npm run inbox:listen` forward AgentMail WebSocket events to the webhook route.
ALLOW_UNSIGNED_WEBHOOKS=
